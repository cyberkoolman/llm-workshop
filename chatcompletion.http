### ---------------------------------------------------------------
### To get a Bearer token, run in terminal:
###   az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
### Then paste the token value into the @token variable below.
### ---------------------------------------------------------------

@endpoint = {{$dotenv OpenAiEndPoint}}
@apiVersion = {{$dotenv OpenAiVersion}}
@token = eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsIng1dCI6ImFGa21LVkZjLTRXVjZzWENCdk5aa1hJNTA1WSIsImtpZCI6ImFGa21LVkZjLTRXVjZzWENCdk5aa1hJNTA1WSJ9._.RBvG0U37E5HJXv997E9pl6aGoQKk2kqHr9sE3dAtQxitGmJ8JdYNRfIGRnOseK3wikqyR2YDqyGL5mibahlc2fSVBqs1Q7Ly1wj5kCjPoffB3P8FSTHCsOtfc0XSHnUwoIetmPKXCzDGqHzaspo0FOvxFyIp-9l45SRGlpbZvrBo_S0UitWmyHfQzee3gV5r4aDSI9X8Ffw7cq76VoF2da6DdQEB0NamUSUW8364ZfwZx6XDjbXufaOhG8MSy-bK4H06rnY0ReRrqU6kLeDo4EJdSD4EKhpSsaB3-td2O7ICld7sE_BHjS5c2r_XKnlI1O6uAVf9ZsHBLhONlDNjhA

### 1. Basic chat completion — fire once to confirm it works
POST {{endpoint}}openai/deployments/gpt-4o/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 1000,
  "messages": [
    {
      "role": "user",
      "content": "What year is your knowledge cutoff?"
    }
  ]
}

### 2. Small max_tokens — observe token usage in response headers (x-ratelimit-remaining-tokens)
POST {{endpoint}}openai/deployments/gpt-4o/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 250,
  "messages": [
    {
      "role": "user",
      "content": "What year is your knowledge cutoff?"
    }
  ]
}

### 3. Large max_tokens — rapid-fire this to trigger 429 rate limiting
POST {{endpoint}}openai/deployments/gpt-4o/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 4000,
  "messages": [
    {
      "role": "user",
      "content": "Generate a very long poem about AI, machine learning, and the future of humanity."
    }
  ]
}

### 4. Multiple completions (n=2) — doubles token consumption, easier to hit limits
POST {{endpoint}}openai/deployments/gpt-4o/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 2000,
  "n": 2,
  "temperature": 1.5,
  "messages": [
    {
      "role": "user",
      "content": "Hello!"
    }
  ]
}
