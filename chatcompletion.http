### ---------------------------------------------------------------
### To get a Bearer token, run in terminal:
###   az account get-access-token --resource https://cognitiveservices.azure.com --query accessToken -o tsv
### Then paste the token value into the @token variable below.
### ---------------------------------------------------------------

@endpoint = {{$dotenv OpenAiEndPoint}}
@apiVersion = {{$dotenv OpenAiVersion}}
@token = eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsIng1dCI6ImFGa21LVkZjLTRXVjZzWENCdk5aa1hJNTA1WSIsImtpZCI6ImFGa21LVkZjLTRXVjZzWENCdk5aa1hJNTA1WSJ9._.D60Cwd31M-lz4m3Lk-vh8UvGNmOGTI0Guur-niS-oQOYa_RSq7AVwGSS5znniAtTWafi-SKZ80hYg1v8JoEzSg0upqpDjS9hX7iE0mlWOkOLW07Qq8jgJE-mIGNTJlL1BkBT58cUiTUGQ669FoZj5vuXPFaqbkSTN8O1X2911-YgN2-5rk6aJVM4f3nqElggfrGoUphZ5jYqeNWjXN38qv2J1TG7zwyKk6_wqpWbQjTr7IGLkEkqUgfxYcAdah_1HnHbi3DSpKTvDjyB7mG5VXg-drOHPbSVkrAA9VKqKbSxmA_KevGXOV0rkSIAMYwt_2yyb4oqNyZI-XfLCFtvCQ

### 1. Basic chat completion — fire once to confirm it works
POST {{endpoint}}openai/deployments/gpt-4.1/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 1000,
  "messages": [
    {
      "role": "user",
      "content": "What year is your knowledge cutoff?"
    }
  ]
}

### 2. Small max_tokens — observe token usage in response headers (x-ratelimit-remaining-tokens)
POST {{endpoint}}openai/deployments/gpt-4.1/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 250,
  "messages": [
    {
      "role": "user",
      "content": "What year is your knowledge cutoff?"
    }
  ]
}

### 3. Large max_tokens — rapid-fire this to trigger 429 rate limiting
POST {{endpoint}}openai/deployments/gpt-4.1/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 4000,
  "messages": [
    {
      "role": "user",
      "content": "Generate a very long poem about AI, machine learning, and the future of humanity."
    }
  ]
}

### 4. Multiple completions (n=2) — doubles token consumption, easier to hit limits
POST {{endpoint}}openai/deployments/gpt-4.1/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 2000,
  "n": 2,
  "temperature": 1.5,
  "messages": [
    {
      "role": "user",
      "content": "Hello!"
    }
  ]
}


### 5. Prompt caching demo — send this twice, check cached_tokens on 2nd call
POST {{endpoint}}openai/deployments/gpt-4.1/chat/completions?api-version={{apiVersion}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "max_tokens": 100,
  "messages": [
    {
      "role": "system",
